# syntax=docker/dockerfile:1.7

FROM golang:1.25.13-bookworm AS go-toolchain
FROM node:22-bookworm AS builder

ARG TARGETARCH
ARG VERSION
ARG COMMIT=unknown
ARG BUILD_DATE=unknown
ARG WAILS_VERSION=v2.15.0

RUN DEBIAN_FRONTEND=noninteractive apt-get update \
    && apt-get install -y --no-install-recommends \
      build-essential ca-certificates libgtk-3-dev libwebkit2gtk-4.1-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*

COPY --from=go-toolchain /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}"

WORKDIR /source
COPY . .

RUN node scripts/release/set-wails-version.mjs cmd/yuri/wails.json "$VERSION"
RUN --mount=type=cache,target=/root/.npm \
    npm --prefix frontend ci --no-audit --no-fund \
    && npm --prefix frontend run build
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    GOBIN=/tools go install "github.com/wailsapp/wails/v2/cmd/wails@${WAILS_VERSION}"
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    cd cmd/yuri \
    && /tools/wails build -clean -platform "linux/${TARGETARCH}" -trimpath \
      -ldflags "-s -w -X github.com/OrdoAI/yuri-agent/internal/buildinfo.Version=${VERSION} -X github.com/OrdoAI/yuri-agent/internal/buildinfo.Commit=${COMMIT} -X github.com/OrdoAI/yuri-agent/internal/buildinfo.Date=${BUILD_DATE}" \
      -tags webkit2_41 -m -nosyncgomod -s -o "yuri-linux-${TARGETARCH}" \
    && mkdir -p /release \
    && cp "build/bin/yuri-linux-${TARGETARCH}" /release/

FROM scratch AS artifact
COPY --from=builder /release/ /
